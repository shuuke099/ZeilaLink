generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String              @id @default(cuid())
  slug                String?             @unique
  name                String
  email               String              @unique
  passwordHash        String              @map("password_hash")
  role                UserRole            @default(worker)
  phone               String?
  location            String?
  bio                 String?
  bioSo               String?             @map("bio_so")
  headline            String?
  headlineSo          String?             @map("headline_so")
  profilePublic       Boolean             @default(false) @map("profile_public")
  preferredLanguage   String              @default("en") @map("preferred_language")
  isVerified          Boolean             @default(false) @map("is_verified")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  avatarUrl           String?             @map("avatar_url")
  verificationExpires DateTime?           @map("verification_expires")
  verificationToken   String?             @map("verification_token")
  applications        Application[]
  auditLogs           AuditLog[]
  employer            Employer?
  sentMessages        Message[]           @relation("SentMessages")
  receivedMessages    Message[]           @relation("ReceivedMessages")
  provider            Provider?
  resumes             Resume[]
  serviceBookings     ServiceBooking[]
  userCertifications  UserCertification[]
  userSkills          UserSkill[]
  workerEducations    WorkerEducation[]
  workerExperiences   WorkerExperience[]
  workerLanguages     WorkerLanguage[]
  workerPreference    WorkerPreference?
  businesses          Business[]

  @@index([role, createdAt])
  @@index([role, isVerified, profilePublic, createdAt])
  @@map("users")
}

model Employer {
  id         String  @id @default(cuid())
  slug       String? @unique
  userId     String  @unique @map("user_id")
  businessId String? @unique @map("business_id")

  name          String
  nameSo        String? @map("name_so")
  description   String?
  descriptionSo String? @map("description_so")

  logoUrl   String? @map("logo_url")
  bannerUrl String? @map("banner_url")

  website String?
  phone   String?
  email   String?

  address    String?
  city       String?
  state      String?
  postalCode String? @map("postal_code")
  country    String  @default("US")

  verified   Boolean   @default(false)
  verifiedAt DateTime? @map("verified_at")
  active     Boolean   @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  jobs     Job[]

  @@index([active, verified, createdAt])
  @@index([city, state])
  @@index([country, state, city])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "employers_name_trgm_idx")
  @@map("employers")
}

model Business {
  id     String  @id @default(cuid())
  slug   String? @unique
  userId String  @map("user_id")

  name          String
  nameSo        String? @map("name_so")
  description   String?
  descriptionSo String? @map("description_so")

  category    String
  subcategory String?

  logoUrl   String?  @map("logo_url")
  bannerUrl String?  @map("banner_url")
  gallery   String[] @default([])

  phone   String?
  email   String?
  website String?

  address    String?
  city       String?
  state      String?
  postalCode String?         @map("postal_code")
  country    String          @default("US")
  deals      Deal[]
  latitude   Float?
  longitude  Float?
  timezone   String?
  hours      BusinessHours[]

  hasPhysicalLocation Boolean  @default(false) @map("has_physical_location")
  serviceArea         String[] @default([]) @map("service_area")
  remoteAvailable     Boolean  @default(false) @map("remote_available")

  rating       Float @default(0)
  reviewsCount Int   @default(0) @map("reviews_count")
  viewsCount   Int   @default(0) @map("views_count")

  verified Boolean @default(false)
  claimed  Boolean @default(false)

  featured      Boolean   @default(false)
  featuredUntil DateTime? @map("featured_until")

  published Boolean @default(true)
  active    Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  employer Employer?
  provider Provider?
  services Service[]

  @@index([published, active, createdAt])
  @@index([category])
  @@index([category, subcategory])
  @@index([city, state])
  @@index([country, state, city])
  @@index([verified, createdAt])
  @@index([featured, featuredUntil])
  @@index([userId])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "businesses_name_trgm_idx")
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, map: "businesses_description_trgm_idx")
  @@map("businesses")
}

model BusinessHours {
  id         String  @id @default(cuid())
  businessId String
  dayOfWeek  Int
  openTime   String?
  closeTime  String?
  closed     Boolean @default(false)

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, dayOfWeek])
  @@index([businessId])
}

model Deal {
  id            String    @id @default(cuid())
  slug          String?   @unique
  title         String
  description   String?
  discountText  String
  discountType  String?
  discountValue Float?
  promoCode     String?
  imageUrl      String?
  terms         String?
  startDate     DateTime?
  validUntil    DateTime?
  active        Boolean   @default(true)
  published     Boolean   @default(false)
  featured      Boolean   @default(false)
  viewsCount    Int       @default(0)
  clicksCount   Int       @default(0)
  businessId    String
  business      Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([businessId])
  @@index([published, active])
  @@index([featured])
  @@index([validUntil])
  @@index([createdAt])
}

model Job {
  id   String  @id @default(cuid())
  slug String? @unique

  title          String
  titleSo        String? @map("title_so")
  description    String
  descriptionSo  String? @map("description_so")
  requirements   String
  requirementsSo String? @map("requirements_so")
  benefits       String?
  benefitsSo     String? @map("benefits_so")

  employerId String @map("employer_id")

  location   String
  city       String?
  state      String?
  postalCode String? @map("postal_code")
  country    String  @default("US")

  remote Boolean @default(false)

  salaryMin      Int?    @map("salary_min")
  salaryMax      Int?    @map("salary_max")
  salaryCurrency String  @default("USD") @map("salary_currency")
  salaryPeriod   String? @map("salary_period")

  employmentType String @map("employment_type")

  tags String[] @default([])

  published  Boolean @default(false)
  viewsCount Int     @default(0) @map("views_count")

  applicationDeadline DateTime? @map("application_deadline")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  applications Application[]
  employer     Employer      @relation(fields: [employerId], references: [id], onDelete: Cascade)
  messages     Message[]

  @@index([published, createdAt])
  @@index([published, employmentType])
  @@index([published, remote])
  @@index([employerId, createdAt])
  @@index([location])
  @@index([city, state])
  @@index([country, state, city])
  @@index([salaryMin])
  @@index([salaryMax])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "jobs_title_trgm_idx")
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, map: "jobs_description_trgm_idx")
  @@index([tags], type: Gin, map: "jobs_tags_gin_idx")
  @@map("jobs")
}

model Application {
  id       String  @id @default(cuid())
  jobId    String  @map("job_id")
  userId   String  @map("user_id")
  resumeId String? @map("resume_id")

  coverLetter   String?           @map("cover_letter")
  status        ApplicationStatus @default(applied)
  statusHistory Json              @default("[]") @map("status_history")

  appliedAt DateTime @default(now()) @map("applied_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  job               Job                @relation(fields: [jobId], references: [id], onDelete: Cascade)
  resume            Resume?            @relation(fields: [resumeId], references: [id], onDelete: SetNull)
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  workerExperiences WorkerExperience[]

  @@unique([jobId, userId])
  @@index([userId, appliedAt])
  @@index([jobId, appliedAt])
  @@index([status, appliedAt])
  @@index([jobId, status])
  @@map("applications")
}

model Service {
  id   String  @id @default(cuid())
  slug String? @unique

  title         String
  titleSo       String? @map("title_so")
  description   String
  descriptionSo String? @map("description_so")

  category    String
  subcategory String?

  provider   String
  businessId String? @map("business_id")

  priceLabel String? @map("price_label")
  priceFrom  Float?  @map("price_from")
  priceType  String? @map("price_type")

  image   String?
  gallery String[] @default([])

  phone   String?
  email   String?
  website String?

  address    String?
  city       String?
  state      String?
  postalCode String? @map("postal_code")
  country    String  @default("US")
  latitude   Float?
  longitude  Float?

  serviceArea     String[] @default([]) @map("service_area")
  remoteAvailable Boolean  @default(false) @map("remote_available")

  availabilityMode String @default("contact") @map("availability_mode")

  rating       Float @default(0)
  reviewsCount Int   @default(0) @map("reviews_count")
  viewsCount   Int   @default(0) @map("views_count")

  verified      Boolean   @default(false)
  featured      Boolean   @default(false)
  featuredUntil DateTime? @map("featured_until")

  published Boolean @default(true)
  active    Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  business Business?        @relation(fields: [businessId], references: [id], onDelete: SetNull)
  bookings ServiceBooking[]

  @@index([published, active, createdAt])
  @@index([published, category])
  @@index([category, subcategory])
  @@index([businessId])
  @@index([city, state])
  @@index([country, state, city])
  @@index([published, featured, featuredUntil])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "services_title_trgm_idx")
  @@index([provider(ops: raw("gin_trgm_ops"))], type: Gin, map: "services_provider_trgm_idx")
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, map: "services_description_trgm_idx")
  @@map("services")
}

model ServiceBooking {
  id                      String    @id @default(cuid())
  serviceId               String    @map("service_id")
  userId                  String?   @map("user_id")
  customerName            String    @map("customer_name")
  customerEmail           String    @map("customer_email")
  customerPhone           String?   @map("customer_phone")
  notes                   String?
  status                  String    @default("pending")
  serviceDateTime         DateTime? @map("service_date_time")
  isRemote                Boolean   @default(false) @map("is_remote")
  locationAddress         String?   @map("location_address")
  stripeCheckoutSessionId String?   @unique @map("stripe_checkout_session_id")
  paymentStatus           String    @default("pending") @map("payment_status")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([serviceId, createdAt])
  @@index([serviceId, status, serviceDateTime])
  @@index([userId, createdAt])
  @@index([paymentStatus, createdAt])
  @@map("service_bookings")
}

model WorkerExperience {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  jobTitle     String    @map("job_title")
  company      String
  startDate    DateTime  @map("start_date")
  endDate      DateTime? @map("end_date")
  isCurrent    Boolean   @default(false) @map("is_current")
  achievements String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  application   Application? @relation(fields: [applicationId], references: [id])
  applicationId String?

  @@index([userId, startDate])
  @@map("worker_experiences")
}

model WorkerEducation {
  id                String    @id @default(cuid())
  userId            String    @map("user_id")
  degreeLevel       String    @map("degree_level")
  institution       String
  fieldOfStudy      String?   @map("field_of_study")
  certificationName String?   @map("certification_name")
  certificateUrl    String?   @map("certificate_url")
  isVerified        Boolean   @default(false) @map("is_verified")
  startDate         DateTime? @map("start_date")
  endDate           DateTime? @map("end_date")
  isCurrent         Boolean   @default(false) @map("is_current")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("worker_educations")
}

model WorkerLanguage {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  language  String
  level     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, language])
  @@map("worker_languages")
}

model WorkerPreference {
  id               String   @id @default(cuid())
  userId           String   @unique @map("user_id")
  employmentType   String?  @map("employment_type")
  shiftPreference  String?  @map("shift_preference")
  desiredSalaryMin Int?     @map("desired_salary_min")
  desiredSalaryMax Int?     @map("desired_salary_max")
  salaryCurrency   String   @default("USD") @map("salary_currency")
  salaryPeriod     String?  @map("salary_period")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("worker_preferences")
}

model Resume {
  id              String        @id @default(cuid())
  userId          String        @map("user_id")
  s3Url           String        @map("s3_url")
  parsedText      String?       @map("parsed_text")
  skillsExtracted String[]      @default([]) @map("skills_extracted")
  createdAt       DateTime      @default(now()) @map("created_at")
  applications    Application[]
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("resumes")
}

model Skill {
  id            String   @id @default(cuid())
  name          String   @unique
  nameSo        String?  @map("name_so")
  description   String?
  descriptionSo String?  @map("description_so")
  category      String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  courses            CourseSkill[]
  userSkills         UserSkill[]
  userCertifications UserCertification[]

  @@index([category])
  @@index([createdAt])
  @@map("skills")
}

model Provider {
  id            String  @id @default(cuid())
  slug          String? @unique
  contactUserId String? @unique @map("contact_user_id")
  businessId    String? @unique @map("business_id")

  name          String
  nameSo        String? @map("name_so")
  description   String?
  descriptionSo String? @map("description_so")

  logoUrl String? @map("logo_url")
  website String?
  phone   String?
  email   String?

  address    String?
  city       String?
  state      String?
  postalCode String? @map("postal_code")
  country    String  @default("US")
  timezone   String?

  rating     Float     @default(0)
  verified   Boolean   @default(false)
  verifiedAt DateTime? @map("verified_at")
  active     Boolean   @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User?     @relation(fields: [contactUserId], references: [id], onDelete: SetNull)
  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
  courses  Course[]

  @@index([active, verified])
  @@index([city, state])
  @@index([country, state, city])
  @@index([createdAt])
  @@map("providers")
}

model Course {
  id   String  @id @default(cuid())
  slug String? @unique

  name          String
  nameSo        String? @map("name_so")
  description   String
  descriptionSo String? @map("description_so")

  providerId String @map("provider_id")

  category String?
  level    String?

  duration   String
  durationSo String? @map("duration_so")

  deliveryMode String @default("in_person") @map("delivery_mode")

  address    String?
  city       String?
  state      String?
  postalCode String? @map("postal_code")
  country    String  @default("US")
  timezone   String?

  onlineUrl String? @map("online_url")

  startDate            DateTime? @map("start_date")
  endDate              DateTime? @map("end_date")
  registrationDeadline DateTime? @map("registration_deadline")

  schedule   String?
  scheduleSo String? @map("schedule_so")

  cost     Float  @default(0)
  currency String @default("USD")

  enrollmentUrl  String? @map("enrollment_url")
  enrollmentOpen Boolean @default(true) @map("enrollment_open")

  imageUrl String?  @map("image_url")
  gallery  String[] @default([])

  providesCertificate Boolean @default(false) @map("provides_certificate")
  certificateUrl      String? @map("certificate_url")

  published     Boolean   @default(false)
  featured      Boolean   @default(false)
  featuredUntil DateTime? @map("featured_until")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  provider           Provider            @relation(fields: [providerId], references: [id], onDelete: Cascade)
  skills             CourseSkill[]
  userCertifications UserCertification[]

  @@index([published, createdAt])
  @@index([providerId, createdAt])
  @@index([published, featured, featuredUntil])
  @@index([published, cost])
  @@index([published, deliveryMode])
  @@index([category])
  @@index([level])
  @@index([city, state])
  @@index([country, state, city])
  @@index([startDate])
  @@index([registrationDeadline])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "courses_name_trgm_idx")
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, map: "courses_description_trgm_idx")
  @@map("courses")
}

model CourseSkill {
  courseId String @map("course_id")
  skillId  String @map("skill_id")

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  skill  Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([courseId, skillId])
  @@index([skillId])
  @@map("course_skills")
}

model UserSkill {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  skillId   String   @map("skill_id")
  level     String   @default("beginner")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill Skill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@index([skillId])
  @@map("user_skills")
}

model UserCertification {
  id             String    @id @default(cuid())
  userId         String    @map("user_id")
  courseId       String    @map("course_id")
  skillId        String?   @map("skill_id")
  issuedAt       DateTime  @default(now()) @map("issued_at")
  expiryDate     DateTime? @map("expiry_date")
  certificateUrl String?   @map("certificate_url")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  skill  Skill? @relation(fields: [skillId], references: [id], onDelete: SetNull)

  @@index([userId, issuedAt])
  @@index([courseId, issuedAt])
  @@index([skillId])
  @@map("user_certifications")
}

model Message {
  id         String    @id @default(cuid())
  fromUserId String    @map("from_user_id")
  toUserId   String    @map("to_user_id")
  jobId      String?   @map("job_id")
  content    String
  read       Boolean   @default(false)
  readAt     DateTime? @map("read_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  fromUser User @relation("SentMessages", fields: [fromUserId], references: [id], onDelete: Cascade)
  job      Job? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  toUser   User @relation("ReceivedMessages", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([fromUserId, createdAt])
  @@index([toUserId, read, createdAt])
  @@index([jobId, createdAt])
  @@map("messages")
}

model AuditLog {
  id           String   @id @default(cuid())
  userId       String?  @map("user_id")
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  meta         Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([resourceType, createdAt])
  @@map("audit_logs")
}

enum UserRole {
  worker
  employer
  provider
  admin
}

enum ApplicationStatus {
  applied
  reviewed
  accepted
  rejected
  withdrawn
}
